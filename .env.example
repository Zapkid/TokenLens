# Data mode: "live" hits the real free APIs, "fixture" serves deterministic
# synthetic data (used by tests and sandboxes without egress). Default: live.
TOKENLENS_DATA_MODE=live

# Optional. CoinGecko Demo API key raises the free rate limit (10k calls/month).
# Server side only. Never expose provider keys via NEXT_PUBLIC_ variables.
COINGECKO_API_KEY=

# Optional. GitHub token for the developer-activity metrics (5k req/hr).
GITHUB_TOKEN=
